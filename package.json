{
  "name": "spine-dots",
  "version": "0.13.0",
  "description": "Open-source governance layer for AI agents: CopilotKit Dots, any MCP runtime, and any OpenAI-compatible model (Grok, OpenAI, open models). The Spine's eight governance layers + the Spine Gate.",
  "type": "module",
  "license": "MIT",
  "author": "SaaSquach AI Labs (https://saasquach.ai)",
  "homepage": "https://github.com/drewmattie-code/spine-dots",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewmattie-code/spine-dots"
  },
  "keywords": [
    "ai-agents",
    "governance",
    "copilotkit",
    "opendots",
    "spine",
    "ai-safety",
    "self-hosted",
    "sovereign-ai",
    "openai",
    "grok",
    "mcp",
    "llm-proxy"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "node demo/run.mjs",
    "demo:vanilla": "node demo/run.mjs --vanilla",
    "gate": "node src/layers/gate.js",
    "test": "node --test",
    "verify": "node bin/spine-verify.js",
    "demo:openai": "node demo/openai-proxy.mjs"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "bin",
    "adapters",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "spine-verify": "bin/spine-verify.js"
  }
}
